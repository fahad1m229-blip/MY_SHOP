# ==============================================================================
# MY SHOP SUPER ADMIN — RENDER BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy to .env for local development ONLY. On Render, set these in Dashboard > Environment.
# NEVER commit real passwords, JWT secrets, or Firebase service-account JSON to GitHub.
# ==============================================================================

PORT=10000
NODE_ENV=production

# Allowed Frontend Origins (comma-separated for CORS with credentials)
ADMIN_FRONTEND_ORIGIN=https://my-shop-admin.onrender.com

# Admin Authentication (Generate password hash via: node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_PASSWORD', 12))")
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@myshop.example
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# Shared Firebase Project & Database (MUST match MY Shop User Panel!)
FIREBASE_PROJECT_ID=gen-lang-client-0209162535
FIRESTORE_DATABASE_ID=ai-studio-android-myshop-e9b08858-2004-4d98-a470-5851be985332
FIREBASE_STORAGE_BUCKET=gen-lang-client-0209162535.firebasestorage.app

# Firebase Admin SDK Service Account Credentials (Set ONE of the following on Render)
# Option A: Minified single-line JSON string from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Base64-encoded service account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option C: Local/Render Secret File path (e.g. /etc/secrets/firebase-service-account.json)
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json

# Payment Gateway Server Credentials (Sandbox / Production — NEVER exposed to frontend)
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
STRIPE_SECRET_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
